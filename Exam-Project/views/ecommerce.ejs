<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Login — E-Commerce Panel</title>
  <link rel="stylesheet" href="/stylesheets/login.css">
</head>
<body>
  <div class="card">
    <div class="card-header">
      <p class="eyebrow">Portfolio Demo</p>
      <h1>E-Commerce Admin</h1>
      <p class="subtitle">Full-stack Node.js app with JWT authentication, role-based access, and MySQL.</p>
    </div>

    <div class="demo-section">
      <p class="demo-label">Try the authentication</p>
      <div class="demo-buttons">
        <button type="button" class="demo-btn demo-valid" onclick="quickLogin('admin@noroff.no', 'P@ssword2023')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          Valid credentials
        </button>
        <button type="button" class="demo-btn demo-invalid" onclick="quickLogin('hacker@evil.com', 'wrongpassword')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          Invalid credentials
        </button>
      </div>
    </div>

    <div class="divider"><span>or enter manually</span></div>

    <form id="login-form" novalidate>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" placeholder="admin@noroff.no" required>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" placeholder="••••••••" required>
      </div>
      <div id="error-msg" class="error-msg" hidden></div>
      <button type="submit" class="submit-btn">Sign in</button>
    </form>
  </div>

  <script src="/js/login.js"></script>
</body>
</html>
