{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd Exam-Project && npm install"
  },
  "deploy": {
    "startCommand": "cd Exam-Project && node ./bin/www",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
