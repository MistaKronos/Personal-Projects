<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - Products</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/navbar.css" />
    <link rel="stylesheet" href="/stylesheets/products.css">

    
  </head>
  <body>
    <%- include('partials/navbar.ejs') %>


    
    <div class="container mt-5">
      <h2>Products Management</h2>
      <form id="add-product-form" onsubmit="addProduct(event)">
        <input id="name" type="text" placeholder="Name" required />
        <input
          id="description"
          type="text"
          placeholder="Description"
          required
        ></input>
        <input id="quantity" type="number" placeholder="Quantity" required />
        <input id="price" type="text" placeholder="Price" required />
        <input id="imageUrl" type="text" placeholder="Image URL" required />
        <div class="row">
        <select id="brandId" class="form-select" required>
          <% brands.forEach(function(brand) { %>
          <option value="<%= brand.id %>"><%= brand.name %></option>
          <% }); %>
        </select>
        <select id="categoryId" class="form-select" required>
          <% categories.forEach(function(category) { %>
          <option value="<%= category.id %>"><%= category.name %></option>
          <% }); %>
        </select>
        <button type="submit" class="btn btn-success">Add Product</button>
      </form>
    </div>

      <div class="row mb-4 search-row">
        <div class="col">
          <input id="search-name" type="text" class="form-control" placeholder="Search by product name..." />
        </div>
        <div class="col">
          <select id="search-category" class="form-select">
            <option value="">All Categories</option>
            <% categories.forEach(function(category) { %>
              <option value="<%= category.name %>"><%= category.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="col">
          <select id="search-brand" class="form-select">
            <option value="">All Brands</option>
            <% brands.forEach(function(brand) { %>
              <option value="<%= brand.name %>"><%= brand.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-auto">
          <button id="search-button" class="btn btn-primary">Search</button>
          <button id="clear-button" type="button" class="btn btn-secondary">Clear</button>
        </div>
      </div>
      

      <table class="table">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Name</th>
            <th scope="col">Description</th>
            <th scope="col">Quantity</th>
            <th scope="col">Price</th>
            <th scope="col">Brand</th>
            <th scope="col">Category</th>
            <th scope="col">Image URL</th>
            <th scope="col">Is Deleted</th>
            <th scope="col">Date Added</th>
            <th scope="col">Options</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function(product) { %>
          <tr>
            <td><%= product.id %></td>
            <td><%= product.name %></td>
            <td><%= product.description %></td>
            <td><%= product.quantity %></td>
            <td><%= product.price %></td>
            <td><%= product.brand.name %></td>
            <td><%= product.category.name %></td>
            <td><img src="<%= product.imageUrl %>" alt="<%= product.name %>" height="50"></td>
            <td><%= product.isDeleted ? 'Yes' : 'No' %></td>
            <td><%= new Date(product.dateAdded).toLocaleDateString() %></td>
            <td>
              <button
                class="btn btn-primary btn-sm"
                onclick="editProduct(<%= product.id %>)"
              >
                Edit
              </button>
              <div
                class="modal fade"
                id="editProductModal"
                tabindex="-1"
                aria-labelledby="editProductModalLabel"
                aria-hidden="true"
              >
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="editProductModalLabel">
                        Edit Product
                      </h5>
                      <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                      ></button>
                    </div>
                    <div class="modal-body">
                      <form
                        id="edit-product-form"
                        onsubmit="updateProduct(event)"
                      >
                        <input id="edit-product-id" type="hidden" />
                        <input
                          id="edit-name"
                          type="text"
                          placeholder="Name"
                          required
                          class="form-control mb-2"
                        />
                        <textarea
                          id="edit-description"
                          placeholder="Description"
                          required
                          class="form-control mb-2"
                        ></textarea>
                        <input
                          id="edit-quantity"
                          type="number"
                          placeholder="Quantity"
                          required
                          class="form-control mb-2"
                        />
                        <input
                          id="edit-price"
                          type="text"
                          placeholder="Price"
                          required
                          class="form-control mb-2"
                        />
                        <input
                          id="edit-imageUrl"
                          type="text"
                          placeholder="Image URL"
                          required
                          class="form-control mb-2"
                        />
                        <select
                          id="edit-brandId"
                          required
                          class="form-control mb-2"
                        >
                          <% brands.forEach(function(brand) { %>
                          <option value="<%= brand.id %>">
                            <%= brand.name %>
                          </option>
                          <% }); %>
                        </select>
                        <select
                          id="edit-categoryId"
                          required
                          class="form-control mb-2"
                        >
                          <% categories.forEach(function(category) { %>
                          <option value="<%= category.id %>">
                            <%= category.name %>
                          </option>
                          <% }); %>
                        </select>
                        <div class="form-check mb-2">
                          <input
                            class="form-check-input"
                            type="checkbox"
                            id="edit-isDeleted"
                          />
                          <label class="form-check-label" for="edit-isDeleted">
                            Is Deleted?
                          </label>
                        </div>
                        <button type="submit" class="btn btn-success">
                          Update Product
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
              <button
                class="btn btn-danger btn-sm"
                onclick="deleteProduct(<%= product.id %>)"
              >
                Delete
              </button>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="/js/products.js"></script>
  </body>
</html>
